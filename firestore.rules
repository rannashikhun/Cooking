rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'rannashikhun@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isBootstrappedModerator() {
      return isSignedIn() && request.auth.token.email == 'p8801764484696@phone.rannashikhun.app';
    }

    function isModerator() {
      return isBootstrappedModerator() || (
        isSignedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
      );
    }

    function hasActivePaidSubData(u) {
      return u.subscriptionStatus == 'active' &&
        u.subscriptionPlan in ['standard', 'pro'] &&
        (!('subscriptionExpiresAt' in u) || u.subscriptionExpiresAt > request.time);
    }

    function effectivePremiumQuota(u) {
      return ('premiumRecipeQuota' in u && u.premiumRecipeQuota is int && u.premiumRecipeQuota > 0)
        ? u.premiumRecipeQuota
        : (u.subscriptionPlan == 'pro' ? 25 : (u.subscriptionPlan == 'standard' ? 10 : 0));
    }

    function isPermanentlyUnlockedPremium(u, recipeId) {
      return ('premiumUnlockedRecipeIds' in u && recipeId in u.premiumUnlockedRecipeIds) ||
        ('unlockedRecipeIds' in u && recipeId in u.unlockedRecipeIds);
    }

    function freeRecipeAccessAllowed(u, recipeId) {
      return ('freeUnlockedRecipeIds' in u && recipeId in u.freeUnlockedRecipeIds) ||
        ('unlockedRecipeIds' in u && recipeId in u.unlockedRecipeIds) ||
        !('freeUnlockedRecipeIds' in u) ||
        u.freeUnlockedRecipeIds.size() < 10;
    }

    // Entity validation helpers
    function isValidRecipe(data) {
      return data.keys().hasAll([
          'title', 'subtitle', 'imageUrl', 'cuisine', 'dietType', 'category',
          'cookTime', 'difficulty', 'rating', 'ratingCount', 'isPremium',
          'isFeatured', 'orderIndex', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'subtitle', 'imageUrl', 'cuisine', 'dietType', 'category',
          'cookTime', 'prepTime', 'difficulty', 'servings', 'rating',
          'ratingCount', 'isPremium', 'isFeatured', 'orderIndex',
          'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.subtitle is string && data.subtitle.size() <= 260 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000 &&
        data.cuisine is string && data.cuisine.size() <= 40 &&
        data.dietType in ['ভেজ', 'নন-ভেজ'] &&
        data.category is string && data.category.size() <= 40 &&
        data.cookTime is string && data.cookTime.size() <= 40 &&
        (!('prepTime' in data) || (data.prepTime is string && data.prepTime.size() <= 40)) &&
        data.difficulty in ['সহজ', 'মাঝারি', 'কঠিন'] &&
        (!('servings' in data) || (data.servings is string && data.servings.size() <= 30)) &&
        (data.rating is number || data.rating is int) && data.rating >= 0 && data.rating <= 5 &&
        data.ratingCount is int && data.ratingCount >= 0 &&
        data.isPremium is bool &&
        data.isFeatured is bool &&
        data.orderIndex is int && data.orderIndex >= 0 &&
        (!('createdByUid' in data) || isValidId(data.createdByUid)) &&
        (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecipeContent(data) {
      return data.keys().hasAll(['ingredients', 'steps', 'chefTip', 'updatedAt']) &&
        data.keys().hasOnly(['ingredients', 'steps', 'stepImages', 'chefTip', 'videoDuration', 'updatedAt']) &&
        data.ingredients is list && data.ingredients.size() <= 40 &&
        (data.ingredients.size() == 0 || data.ingredients[0] is string) &&
        data.steps is list && data.steps.size() <= 40 &&
        (data.steps.size() == 0 || data.steps[0] is string) &&
        (!('stepImages' in data) || (
          data.stepImages is list && data.stepImages.size() <= 40 &&
          (data.stepImages.size() == 0 || data.stepImages[0] is string)
        )) &&
        data.chefTip is string && data.chefTip.size() <= 1200 &&
        (!('videoDuration' in data) || (data.videoDuration is string && data.videoDuration.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidRecipeComment(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt']) &&
        data.keys().hasOnly([
          'authorUid', 'authorName', 'authorPhotoUrl', 'text',
          'parentCommentId', 'replyToUid', 'replyToName', 'createdAt'
        ]) &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 160000)) &&
        data.text is string && data.text.size() >= 2 && data.text.size() <= 1000 &&
        (!('parentCommentId' in data) || isValidId(data.parentCommentId)) &&
        (!('replyToUid' in data) || isValidId(data.replyToUid)) &&
        (!('replyToName' in data) || (data.replyToName is string && data.replyToName.size() <= 100)) &&
        data.createdAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'orderIndex', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'iconKey', 'iconImageUrl', 'orderIndex', 'isActive', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
        (!('iconKey' in data) || (data.iconKey is string && data.iconKey.size() <= 40)) &&
        (!('iconImageUrl' in data) || (data.iconImageUrl is string && data.iconImageUrl.size() <= 160000)) &&
        data.orderIndex is int && data.orderIndex >= 0 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlan(data) {
      return data.keys().hasAll([
          'name', 'tier', 'priceLabel', 'priceAmount', 'durationLabel',
          'durationDays', 'features', 'accentColor', 'isActive', 'orderIndex', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'tier', 'priceLabel', 'priceAmount', 'durationLabel',
          'durationDays', 'recipeLimit', 'subtitle', 'features', 'accentColor', 'isActive', 'orderIndex', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.tier in ['basic', 'standard', 'pro'] &&
        data.priceLabel is string && data.priceLabel.size() <= 80 &&
        data.priceAmount is int && data.priceAmount >= 0 &&
        data.durationLabel is string && data.durationLabel.size() <= 80 &&
        data.durationDays is int && data.durationDays >= 1 &&
        (!('recipeLimit' in data) || (data.recipeLimit is int && data.recipeLimit >= 1 && data.recipeLimit <= 1000)) &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 140)) &&
        data.features is list && data.features.size() <= 10 &&
        (data.features.size() == 0 || data.features[0] is string) &&
        data.accentColor in ['green', 'gold', 'red'] &&
        data.isActive is bool &&
        data.orderIndex is int && data.orderIndex >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'role', 'subscriptionPlan',
          'subscriptionStatus', 'favoriteRecipeIds', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phoneNumber', 'photoURL', 'address', 'age', 'role', 'subscriptionPlan',
          'subscriptionStatus', 'subscriptionExpiresAt', 'lastOrderId',
          'favoriteRecipeIds', 'unlockedRecipeIds', 'freeUnlockedRecipeIds',
          'premiumUnlockedRecipeIds', 'premiumRecipeQuota', 'viewedHistory',
          'isOnline', 'lastActiveAt', 'lastLoginDevice', 'lastLoginLocation',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 160 &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 160000)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 240)) &&
        (!('age' in data) || (data.age is int && data.age >= 1 && data.age <= 120)) &&
        data.role in ['member', 'moderator', 'admin'] &&
        data.subscriptionPlan in ['basic', 'standard', 'pro'] &&
        data.subscriptionStatus in ['active', 'expired'] &&
        (!('subscriptionExpiresAt' in data) || data.subscriptionExpiresAt is timestamp) &&
        (!('lastOrderId' in data) || isValidId(data.lastOrderId)) &&
        data.favoriteRecipeIds is list && data.favoriteRecipeIds.size() <= 100 &&
        (data.favoriteRecipeIds.size() == 0 || data.favoriteRecipeIds[0] is string) &&
        (!('unlockedRecipeIds' in data) || (
          data.unlockedRecipeIds is list && data.unlockedRecipeIds.size() <= 500 &&
          (data.unlockedRecipeIds.size() == 0 || data.unlockedRecipeIds[0] is string)
        )) &&
        (!('freeUnlockedRecipeIds' in data) || (
          data.freeUnlockedRecipeIds is list && data.freeUnlockedRecipeIds.size() <= 200 &&
          (data.freeUnlockedRecipeIds.size() == 0 || data.freeUnlockedRecipeIds[0] is string)
        )) &&
        (!('premiumUnlockedRecipeIds' in data) || (
          data.premiumUnlockedRecipeIds is list && data.premiumUnlockedRecipeIds.size() <= 500 &&
          (data.premiumUnlockedRecipeIds.size() == 0 || data.premiumUnlockedRecipeIds[0] is string)
        )) &&
        (!('premiumRecipeQuota' in data) || (data.premiumRecipeQuota is int && data.premiumRecipeQuota >= 0 && data.premiumRecipeQuota <= 500)) &&
        (!('viewedHistory' in data) || (
          data.viewedHistory is list && data.viewedHistory.size() <= 50 &&
          (data.viewedHistory.size() == 0 || (
            data.viewedHistory[0] is map &&
            data.viewedHistory[0].keys().hasAll(['recipeId', 'viewedAt']) &&
            data.viewedHistory[0].keys().hasOnly(['recipeId', 'viewedAt']) &&
            data.viewedHistory[0].recipeId is string &&
            data.viewedHistory[0].recipeId.size() >= 1 &&
            data.viewedHistory[0].recipeId.size() <= 128 &&
            data.viewedHistory[0].viewedAt is int
          ))
        )) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('lastActiveAt' in data) || data.lastActiveAt is timestamp) &&
        (!('lastLoginDevice' in data) || (data.lastLoginDevice is string && data.lastLoginDevice.size() <= 160)) &&
        (!('lastLoginLocation' in data) || (data.lastLoginLocation is string && data.lastLoginLocation.size() <= 160)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'isRead', 'createdAt']) &&
        data.keys().hasOnly([
          'type', 'title', 'message', 'recipeId', 'orderId',
          'senderUid', 'senderName', 'isRead', 'createdAt'
        ]) &&
        data.type in [
          'comment_reply', 'payment_approved', 'payment_rejected', 'payment_pending',
          'free_limit_reached', 'pro_limit_reached', 'plan_expiry_reminder', 'admin_message'
        ] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
        (!('recipeId' in data) || (data.recipeId is string && data.recipeId.size() >= 1 && data.recipeId.size() <= 128)) &&
        (!('orderId' in data) || isValidId(data.orderId)) &&
        (!('senderUid' in data) || isValidId(data.senderUid)) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100)) &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidDirectThread(data) {
      return data.keys().hasAll([
          'userId', 'userName', 'lastMessage', 'lastSenderRole',
          'unreadByAdmin', 'unreadByUser', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'userName', 'userContact', 'userPhotoURL',
          'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByUser', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        (!('userContact' in data) || (data.userContact is string && data.userContact.size() <= 160)) &&
        (!('userPhotoURL' in data) || (data.userPhotoURL is string && data.userPhotoURL.size() <= 160000)) &&
        data.lastMessage is string && data.lastMessage.size() <= 1000 &&
        data.lastSenderRole in ['admin', 'user'] &&
        data.unreadByAdmin is int && data.unreadByAdmin >= 0 && data.unreadByAdmin <= 10000 &&
        data.unreadByUser is int && data.unreadByUser >= 0 && data.unreadByUser <= 10000 &&
        data.updatedAt is timestamp;
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll(['senderUid', 'senderName', 'senderRole', 'text', 'createdAt']) &&
        data.keys().hasOnly(['senderUid', 'senderName', 'senderRole', 'text', 'createdAt']) &&
        isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
        data.senderRole in ['admin', 'user'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidSubscriptionOrder(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'userName', 'planId', 'planName',
          'planTier', 'durationDays', 'amount', 'paymentMethod', 'senderNumber',
          'transactionId', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'planId', 'planName',
          'planTier', 'durationDays', 'recipeLimit', 'amount', 'paymentMethod', 'senderNumber',
          'transactionId', 'status', 'createdAt'
        ]) &&
        isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() <= 160 &&
        data.userName is string && data.userName.size() <= 100 &&
        data.planId is string && data.planId.size() <= 64 &&
        data.planName is string && data.planName.size() <= 80 &&
        data.planTier in ['basic', 'standard', 'pro'] &&
        data.durationDays is int && data.durationDays >= 1 &&
        (!('recipeLimit' in data) || (data.recipeLimit is int && data.recipeLimit >= 1 && data.recipeLimit <= 1000)) &&
        data.amount is int && data.amount >= 0 &&
        data.paymentMethod in ['বিকাশ', 'নগদ', 'রকেট', 'ব্যাংক', 'ফ্রি'] &&
        data.senderNumber is string && data.senderNumber.size() <= 40 &&
        data.transactionId is string && data.transactionId.size() <= 80 &&
        (data.senderNumber.size() >= 6 || data.transactionId.size() >= 3) &&
        data.status in ['pending', 'active', 'rejected', 'revoked'] &&
        data.createdAt is timestamp;
    }

    function isValidTip(data) {
      return data.keys().hasAll(['title', 'category', 'summary', 'content', 'readTime', 'isPublished', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'category', 'summary', 'content', 'readTime', 'isPublished', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.category is string && data.category.size() <= 50 &&
        data.summary is string && data.summary.size() <= 300 &&
        data.content is string && data.content.size() <= 5000 &&
        data.readTime is string && data.readTime.size() <= 30 &&
        data.isPublished is bool &&
        (!('createdByUid' in data) || isValidId(data.createdByUid)) &&
        (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'excerpt', 'content', 'imageUrl', 'authorName', 'category', 'readTime', 'isPublished', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'excerpt', 'content', 'imageUrl', 'authorName', 'category', 'readTime', 'isPublished', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.excerpt is string && data.excerpt.size() <= 320 &&
        data.content is string && data.content.size() <= 8000 &&
        data.imageUrl is string && data.imageUrl.size() <= 350000 &&
        data.authorName is string && data.authorName.size() <= 80 &&
        data.category is string && data.category.size() <= 50 &&
        data.readTime is string && data.readTime.size() <= 30 &&
        data.isPublished is bool &&
        (!('createdByUid' in data) || isValidId(data.createdByUid)) &&
        (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isStrMax(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidSiteFonts(data) {
      return [
        data.get('recipeFontDesktop', 'bensen'),
        data.get('recipeFontMobile', 'bensen'),
        data.get('adminFontFamily', 'hind-siliguri'),
        data.get('adminFontMobile', 'hind-siliguri'),
        data.get('profileFontFamily', 'hind-siliguri'),
        data.get('profileFontMobile', 'hind-siliguri'),
        data.get('checkoutFontFamily', 'hind-siliguri'),
        data.get('checkoutFontMobile', 'hind-siliguri'),
        data.get('homeFontFamily', 'hind-siliguri'),
        data.get('homeFontMobile', 'hind-siliguri'),
        data.get('pricingFontFamily', 'hind-siliguri'),
        data.get('pricingFontMobile', 'hind-siliguri'),
        data.get('blogTipsFontFamily', 'hind-siliguri'),
        data.get('blogTipsFontMobile', 'hind-siliguri'),
        data.get('authFontFamily', 'hind-siliguri'),
        data.get('authFontMobile', 'hind-siliguri')
      ].hasOnly([
        'bensen', 'atma', 'alkatra', 'galada', 'tiro-italic',
        'noto-serif', 'tiro', 'hind-siliguri', 'anek-bangla',
        'baloo-da-2', 'mina', 'noto-sans'
      ]) && [
        data.get('recipeFontSizeDesktop', '100'),
        data.get('recipeFontSizeMobile', '100'),
        data.get('adminFontSize', '100'),
        data.get('adminFontSizeMobile', '100'),
        data.get('profileFontSize', '100'),
        data.get('profileFontSizeMobile', '100'),
        data.get('checkoutFontSize', '100'),
        data.get('checkoutFontSizeMobile', '100'),
        data.get('homeFontSize', '100'),
        data.get('homeFontSizeMobile', '100'),
        data.get('pricingFontSize', '100'),
        data.get('pricingFontSizeMobile', '100'),
        data.get('blogTipsFontSize', '100'),
        data.get('blogTipsFontSizeMobile', '100'),
        data.get('authFontSize', '100'),
        data.get('authFontSizeMobile', '100')
      ].hasOnly(['100', '105', '110', '115', '120', 'sm', 'md', 'lg', 'xl']);
    }

    function isValidSiteSeoAndSocial(data) {
      return isStrMax(data.get('seoTitle', ''), 160) &&
        isStrMax(data.get('seoDescription', ''), 400) &&
        isStrMax(data.get('seoKeywords', ''), 600) &&
        isStrMax(data.get('seoAuthor', ''), 120) &&
        isStrMax(data.get('canonicalBaseUrl', ''), 240) &&
        data.get('seoRobotsPolicy', 'index, follow') in ['index, follow', 'noindex, nofollow'] &&
        isStrMax(data.get('googleSiteVerification', ''), 180) &&
        isStrMax(data.get('googleVerificationFile', ''), 160) &&
        isStrMax(data.get('bingSiteVerification', ''), 180) &&
        isStrMax(data.get('googleAnalyticsId', ''), 60) &&
        isStrMax(data.get('robotsTxtExtra', ''), 1000) &&
        isStrMax(data.get('socialShareImageUrl', ''), 750000) &&
        isStrMax(data.get('socialShareTitle', ''), 160) &&
        isStrMax(data.get('socialShareDescription', ''), 400) &&
        isStrMax(data.get('socialShareImageAlt', ''), 200) &&
        isStrMax(data.get('twitterHandle', ''), 80) &&
        isStrMax(data.get('fbAppId', ''), 60) &&
        data.get('showRecipeShareButton', true) is bool;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['siteName', 'tagline', 'showAnnouncement', 'contactEmail', 'contactPhone', 'contactAddress', 'updatedAt']) &&
        data.keys().hasOnly([
          'siteName', 'tagline', 'announcementText', 'showAnnouncement',
          'paymentBkashNumber', 'paymentNagadNumber', 'paymentInstructions',
          'recipeFontDesktop', 'recipeFontMobile',
          'recipeFontSizeDesktop', 'recipeFontSizeMobile',
          'adminFontFamily', 'adminFontMobile', 'adminFontSize', 'adminFontSizeMobile',
          'profileFontFamily', 'profileFontMobile', 'profileFontSize', 'profileFontSizeMobile',
          'checkoutFontFamily', 'checkoutFontMobile', 'checkoutFontSize', 'checkoutFontSizeMobile',
          'homeFontFamily', 'homeFontMobile', 'homeFontSize', 'homeFontSizeMobile',
          'pricingFontFamily', 'pricingFontMobile', 'pricingFontSize', 'pricingFontSizeMobile',
          'blogTipsFontFamily', 'blogTipsFontMobile', 'blogTipsFontSize', 'blogTipsFontSizeMobile',
          'authFontFamily', 'authFontMobile', 'authFontSize', 'authFontSizeMobile',
          'seoTitle', 'seoDescription', 'seoKeywords', 'seoAuthor',
          'canonicalBaseUrl', 'seoRobotsPolicy',
          'googleSiteVerification', 'googleVerificationFile',
          'bingSiteVerification', 'googleAnalyticsId', 'robotsTxtExtra',
          'socialShareImageUrl', 'socialShareTitle', 'socialShareDescription',
          'socialShareImageAlt', 'twitterHandle', 'fbAppId', 'showRecipeShareButton',
          'contactEmail', 'contactPhone', 'contactAddress', 'footerNote',
          'adminPhotoUrl', 'adminDisplayName', 'updatedAt'
        ]) &&
        data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80 &&
        isStrMax(data.tagline, 240) &&
        isStrMax(data.get('announcementText', ''), 240) &&
        data.showAnnouncement is bool &&
        isStrMax(data.get('paymentBkashNumber', ''), 60) &&
        isStrMax(data.get('paymentNagadNumber', ''), 60) &&
        isStrMax(data.get('paymentInstructions', ''), 600) &&
        isValidSiteFonts(data) &&
        isValidSiteSeoAndSocial(data) &&
        isStrMax(data.contactEmail, 140) &&
        isStrMax(data.contactPhone, 60) &&
        isStrMax(data.contactAddress, 240) &&
        isStrMax(data.get('footerNote', ''), 320) &&
        isStrMax(data.get('adminPhotoUrl', ''), 160000) &&
        isStrMax(data.get('adminDisplayName', ''), 100) &&
        data.updatedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 4 && data.email.size() <= 160 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
        data.status in ['unread', 'read'] &&
        data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['email', 'addedBy', 'createdAt']) &&
        data.email is string && data.email.size() <= 160 &&
        isValidId(data.addedBy) &&
        data.createdAt is timestamp;
    }

    function isValidRecycleBinItem(data) {
      return data.keys().hasAll([
          'itemType', 'originalId', 'title', 'payloadJson',
          'deletedByUid', 'deletedByName', 'deletedAt', 'expiresAt'
        ]) &&
        data.keys().hasOnly([
          'itemType', 'originalId', 'title', 'subtitle', 'category',
          'payloadJson', 'deletedByUid', 'deletedByName', 'deletedAt', 'expiresAt'
        ]) &&
        data.itemType in ['recipe', 'tip', 'blog'] &&
        isValidId(data.originalId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        isStrMax(data.get('subtitle', ''), 320) &&
        isStrMax(data.get('category', ''), 60) &&
        data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 900000 &&
        isValidId(data.deletedByUid) &&
        data.deletedByName is string && data.deletedByName.size() <= 100 &&
        data.deletedAt is timestamp &&
        data.expiresAt is timestamp;
    }

    // 1. Recipes catalog & gated content subcollection
    match /recipes/{recipeId} {
      allow list: if true;
      allow get: if isValidId(recipeId);
      allow create: if isValidId(recipeId) && isValidRecipe(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time && (
          isAdmin() ||
          (isModerator() && incoming().get('createdByUid', '') == request.auth.uid)
        );
      allow update: if isValidId(recipeId) && isValidRecipe(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isModerator() &&
            existing().get('createdByUid', '') == request.auth.uid &&
            incoming().get('createdByUid', '') == existing().get('createdByUid', '')
          )
        );
      allow delete: if isValidId(recipeId) && isAdmin();

      match /content/detail {
        allow get: if isValidId(recipeId) && (
          isAdmin() ||
          (isModerator() && get(/databases/$(database)/documents/recipes/$(recipeId)).data.get('createdByUid', '') == request.auth.uid) ||
          (
            get(/databases/$(database)/documents/recipes/$(recipeId)).data.isPremium == false && (
              !isSignedIn() ||
              !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              freeRecipeAccessAllowed(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, recipeId)
            )
          ) ||
          (
            get(/databases/$(database)/documents/recipes/$(recipeId)).data.isPremium == true &&
            isSignedIn() &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
              isPermanentlyUnlockedPremium(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, recipeId) ||
              (
                hasActivePaidSubData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
                (
                  !('premiumUnlockedRecipeIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.premiumUnlockedRecipeIds.size() < effectivePremiumQuota(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                )
              )
            )
          )
        );
        allow create, update: if isValidId(recipeId) && isValidRecipeContent(incoming()) &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isModerator() && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.get('createdByUid', '') == request.auth.uid)
          );
        allow delete: if isValidId(recipeId) && isAdmin();
      }

      match /comments/{commentId} {
        allow list: if true;
        allow get: if isValidId(commentId);
        allow create: if isValidId(recipeId) && isValidId(commentId) && isSignedIn() &&
          isValidRecipeComment(incoming()) &&
          incoming().authorUid == request.auth.uid &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(commentId) && (
          isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid)
        );
      }
    }

    // 1b. Dynamic Recipe Categories
    match /categories/{categoryId} {
      allow list: if true;
      allow get: if isValidId(categoryId);
      allow create: if isValidId(categoryId) && (isAdmin() || isModerator()) && isValidCategory(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) && (isAdmin() || isModerator()) && isValidCategory(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 2. Subscription Plans
    match /subscriptionPlans/{planId} {
      allow list: if true;
      allow get: if isValidId(planId);
      allow create, update: if isValidId(planId) && isAdmin() && isValidPlan(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(planId) && isAdmin();
    }

    // 3. Users (PII strict owner/admin isolation)
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isSignedIn() && isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().subscriptionStatus == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (incoming().role == 'member' && incoming().subscriptionPlan == 'basic') ||
          (incoming().role == 'moderator' && incoming().subscriptionPlan == 'basic' && isBootstrappedModerator()) ||
          isBootstrappedAdmin()
        );
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isBootstrappedModerator() &&
            isOwner(userId) &&
            incoming().role == 'moderator' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'phoneNumber', 'address', 'age', 'favoriteRecipeIds',
              'freeUnlockedRecipeIds', 'premiumUnlockedRecipeIds',
              'viewedHistory', 'isOnline', 'lastActiveAt', 'lastLoginDevice', 'lastLoginLocation',
              'updatedAt'
            ]) &&
            incoming().subscriptionPlan == existing().subscriptionPlan &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            (!('freeUnlockedRecipeIds' in incoming().diff(existing()).affectedKeys()) || (
              (!('freeUnlockedRecipeIds' in existing()) || incoming().freeUnlockedRecipeIds.hasAll(existing().freeUnlockedRecipeIds)) &&
              incoming().freeUnlockedRecipeIds.size() <= 10
            )) &&
            (!('premiumUnlockedRecipeIds' in incoming().diff(existing()).affectedKeys()) || (
              hasActivePaidSubData(existing()) &&
              (!('premiumUnlockedRecipeIds' in existing()) || incoming().premiumUnlockedRecipeIds.hasAll(existing().premiumUnlockedRecipeIds)) &&
              incoming().premiumUnlockedRecipeIds.size() <= effectivePremiumQuota(existing())
            ))
          ) ||
          (
            // Free Basic plan instant self-activation via order batch
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().subscriptionPlan == 'basic' &&
            incoming().subscriptionStatus == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['subscriptionPlan', 'subscriptionStatus', 'subscriptionExpiresAt', 'lastOrderId', 'updatedAt']) &&
            'lastOrderId' in incoming() &&
            existsAfter(/databases/$(database)/documents/subscriptionOrders/$(incoming().lastOrderId)) &&
            getAfter(/databases/$(database)/documents/subscriptionOrders/$(incoming().lastOrderId)).data.userId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/subscriptionOrders/$(incoming().lastOrderId)).data.planTier == 'basic' &&
            getAfter(/databases/$(database)/documents/subscriptionOrders/$(incoming().lastOrderId)).data.status == 'active'
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /notifications/{notificationId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isValidId(notificationId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(notificationId) && isSignedIn() &&
          isValidUserNotification(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().isRead == false && (
            isAdmin() ||
            (
              incoming().type in ['payment_pending', 'free_limit_reached', 'pro_limit_reached', 'plan_expiry_reminder'] &&
              isOwner(userId)
            ) ||
            (
              incoming().type == 'comment_reply' &&
              'senderUid' in incoming() &&
              incoming().senderUid == request.auth.uid &&
              'recipeId' in incoming() &&
              isValidId(incoming().recipeId) &&
              exists(/databases/$(database)/documents/recipes/$(incoming().recipeId))
            )
          );
        allow update: if isValidId(notificationId) && isSignedIn() && isOwner(userId) &&
          isValidUserNotification(incoming()) &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isValidId(notificationId) && (isOwner(userId) || isAdmin());
      }
    }

    // 4. Subscription Orders (Manual TxID verification for paid plans)
    match /subscriptionOrders/{orderId} {
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow create: if isValidId(orderId) && isSignedIn() &&
        isValidSubscriptionOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time && (
          (incoming().planTier == 'basic' && incoming().amount == 0 && incoming().status == 'active') ||
          (incoming().planTier in ['standard', 'pro'] && incoming().amount > 0 && incoming().status == 'pending')
        );
      allow update: if isValidId(orderId) && isAdmin() &&
        isValidSubscriptionOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 5. Cooking Tips
    match /tips/{tipId} {
      allow list: if true;
      allow get: if isValidId(tipId);
      allow create: if isValidId(tipId) && isValidTip(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time && (
          isAdmin() ||
          (isModerator() && incoming().get('createdByUid', '') == request.auth.uid)
        );
      allow update: if isValidId(tipId) && isValidTip(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isModerator() &&
            existing().get('createdByUid', '') == request.auth.uid &&
            incoming().get('createdByUid', '') == existing().get('createdByUid', '')
          )
        );
      allow delete: if isValidId(tipId) && isAdmin();
    }

    // 6. Blog Posts
    match /blogPosts/{postId} {
      allow list: if true;
      allow get: if isValidId(postId);
      allow create: if isValidId(postId) && isValidBlogPost(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time && (
          isAdmin() ||
          (isModerator() && incoming().get('createdByUid', '') == request.auth.uid)
        );
      allow update: if isValidId(postId) && isValidBlogPost(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isModerator() &&
            existing().get('createdByUid', '') == request.auth.uid &&
            incoming().get('createdByUid', '') == existing().get('createdByUid', '')
          )
        );
      allow delete: if isValidId(postId) && isAdmin();
    }

    // 7. Site Settings
    match /siteSettings/{settingId} {
      allow list: if false;
      allow get: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isAdmin() &&
        isValidSiteSettings(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 8. Contact Messages
    match /contactMessages/{messageId} {
      allow list: if isAdmin();
      allow get: if isValidId(messageId) && isAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming()) &&
        incoming().status == 'unread' && incoming().createdAt == request.time;
      allow update: if isValidId(messageId) && isAdmin() &&
        isValidContactMessage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // 9. Admins Registry
    match /admins/{userId} {
      allow list: if isAdmin();
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isAdmin() && isValidAdminRecord(incoming()) &&
        incoming().addedBy == request.auth.uid && incoming().createdAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 10. Moderators Registry
    match /moderators/{userId} {
      allow list: if isAdmin();
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isAdmin() && isValidAdminRecord(incoming()) &&
        incoming().addedBy == request.auth.uid && incoming().createdAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 11. 30-Day Recycle Bin (Admin only)
    match /recycleBin/{itemId} {
      allow list: if isAdmin();
      allow get: if isValidId(itemId) && isAdmin();
      allow create: if isValidId(itemId) && isAdmin() && isValidRecycleBinItem(incoming()) &&
        incoming().deletedAt == request.time && incoming().expiresAt > request.time;
      allow update: if false;
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // 12. Direct Two-Way Admin <-> User Messaging
    match /directThreads/{userId} {
      allow list: if isAdmin();
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isSignedIn() &&
        isValidDirectThread(incoming()) &&
        incoming().userId == userId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().lastSenderRole == 'user' && incoming().unreadByUser == 0)
        );
      allow update: if isValidId(userId) && isSignedIn() &&
        isValidDirectThread(incoming()) &&
        incoming().userId == existing().userId && (
          isAdmin() ||
          (
            isOwner(userId) && (
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['unreadByUser']) &&
                incoming().unreadByUser == 0
              ) ||
              (
                incoming().lastSenderRole == 'user' &&
                incoming().unreadByUser == 0 &&
                incoming().updatedAt == request.time
              )
            )
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /messages/{messageId} {
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow get: if isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(messageId) && isSignedIn() &&
          isValidDirectMessage(incoming()) &&
          incoming().senderUid == request.auth.uid &&
          incoming().createdAt == request.time && (
            (isAdmin() && incoming().senderRole == 'admin') ||
            (isOwner(userId) && incoming().senderRole == 'user')
          );
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(messageId) && isAdmin();
      }
    }
  }
}
